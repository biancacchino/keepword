{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONSAFEPATH=1 PYTHONPATH=\"${CLAUDE_PLUGIN_ROOT}\" python3 -m keepword.hook",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONSAFEPATH=1 PYTHONPATH=\"${CLAUDE_PLUGIN_ROOT}\" python3 -m keepword.hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
